{
  "name": "@usevibejs/socket",
  "version": "0.1.0",
  "description": "Realtime, Native to Vibe.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibejs/vibesocket.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "default": "./dist/sse.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "default": "./dist/adapters.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "node node_modules/typescript-next/bin/tsc --noEmit --runExternalCode",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt && node scripts/format-vibe.ts --write",
    "check": "pnpm typecheck && pnpm lint && oxfmt --check && node scripts/format-vibe.ts && pnpm test",
    "dev": "node examples/server.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "verify": "pnpm build && pnpm check && pnpm site:build && pnpm test:browser && pnpm pack-check",
    "pack-check": "node scripts/pack-check.ts",
    "bench": "ulimit -n 16384 && node scripts/bench.ts",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@usevibejs/auth": "0.1.1",
    "@usevibejs/compiler": "0.1.0",
    "@usevibejs/dnd": "file:vendor/vibednd.tgz",
    "@usevibejs/i18n": "file:vendor/vibei18n.tgz",
    "@usevibejs/language-tools": "0.1.0",
    "@usevibejs/query": "0.1.1",
    "@usevibejs/server": "0.1.0",
    "@usevibejs/ui": "0.1.0",
    "@usevibejs/virtual": "file:vendor/vibevirtual.tgz",
    "better-auth": "1.7.13",
    "clsx": "2.1.1",
    "miniflare": "4.20260730.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "srvx": "1.0.8",
    "tailwind-merge": "3.7.0",
    "tsdown": "0.23.3",
    "typescript": "7.0.2",
    "typescript-next": "npm:typescript@7.1.0-dev.20261015.1",
    "valibot": "1.5.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@usevibejs/query": "^0.1.0",
    "@usevibejs/ui": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@usevibejs/query": {
      "optional": true
    },
    "@usevibejs/ui": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "ws": "8.22.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "packageManager": "pnpm@12.14.0"
}

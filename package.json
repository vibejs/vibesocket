{
  "name": "@usevibejs/socket",
  "version": "0.1.0",
  "description": "Realtime, Native to Vibe.js",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibejs/vibesocket.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "packageManager": "pnpm@12.14.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "default": "./dist/sse.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "check": "pnpm typecheck && pnpm lint && oxfmt --check && pnpm test",
    "dev": "node examples/server.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "verify": "pnpm build && pnpm check && pnpm site:build && pnpm test:browser && pnpm pack-check",
    "pack-check": "node scripts/pack-check.ts"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0"
  },
  "optionalDependencies": {
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "@usevibejs/ui": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@usevibejs/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@usevibejs/compiler": "0.1.0",
    "@usevibejs/language-tools": "0.1.0",
    "@usevibejs/server": "0.1.0",
    "@usevibejs/ui": "0.1.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "srvx": "1.0.8",
    "tsdown": "0.23.3",
    "typescript": "7.1.0-dev.20261015.1",
    "valibot": "1.5.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
